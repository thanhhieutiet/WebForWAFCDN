{
  "openapi": "3.0.3",
  "info": {
    "title": "LabShop Origin & Security Lab API",
    "version": "1.0.0",
    "description": "LabShop Origin API for CMC WAAP and Multi-CDN lab practice."
  },
  "servers": [
    {
      "url": "/",
      "description": "Origin server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns basic service health status",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/time": {
      "get": {
        "summary": "Current time",
        "description": "Returns current timestamp and request ID without cache headers to observe CDN default cache",
        "tags": ["Lab"],
        "responses": {
          "200": {
            "description": "Current origin time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cache/{mode}": {
      "get": {
        "summary": "Cache behavior test",
        "description": "Tests various origin cache headers (public, no-store, etag, vary, set-cookie)",
        "tags": ["Lab"],
        "parameters": [
          {
            "name": "mode",
            "in": "path",
            "required": true,
            "description": "Cache mode to simulate: public, no-store, etag, vary, set-cookie",
            "schema": {
              "type": "string",
              "enum": ["public", "no-store", "etag", "vary", "set-cookie"]
            }
          },
          {
            "name": "v",
            "in": "query",
            "required": false,
            "description": "Optional version parameter for cache key testing",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cache response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CacheResponse"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified (when If-None-Match matches ETag)"
          },
          "400": {
            "description": "Invalid mode requested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/headers": {
      "get": {
        "summary": "Echo received headers",
        "description": "Returns received headers (redacting sensitive tokens), remote IP, and X-Forwarded-For chain",
        "tags": ["Lab"],
        "responses": {
          "200": {
            "description": "Header details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HeadersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/echo": {
      "get": {
        "summary": "Echo request (GET)",
        "description": "Reflects query, headers, and cookies back as JSON",
        "tags": ["Lab"],
        "responses": {
          "200": {
            "description": "Echoed request data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Echo request (POST)",
        "description": "Reflects body, form, query, headers, and cookies back as JSON",
        "tags": ["Lab"],
        "requestBody": {
          "description": "Optional arbitrary request payload",
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Echoed request data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/echo/{path}": {
      "get": {
        "summary": "Echo request with subpath (GET)",
        "tags": ["Lab"],
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Echoed request data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Echo request with subpath (POST)",
        "tags": ["Lab"],
        "parameters": [
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Echoed request data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/status/{code}": {
      "get": {
        "summary": "Trigger specific HTTP status code",
        "description": "Returns the requested HTTP status code from the supported list",
        "tags": ["Lab"],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "204": { "description": "No Content" },
          "301": { "description": "Moved Permanently" },
          "302": { "description": "Found" },
          "304": { "description": "Not Modified" },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not Found" },
          "429": { "description": "Too Many Requests" },
          "500": { "description": "Internal Server Error" },
          "502": { "description": "Bad Gateway" },
          "503": { "description": "Service Unavailable" },
          "504": { "description": "Gateway Timeout" }
        }
      }
    },
    "/api/slow": {
      "get": {
        "summary": "Simulate slow upstream response",
        "description": "Sleeps for ms milliseconds (clamped to MAX_SLOW_MS), max 20 concurrent requests",
        "tags": ["Lab"],
        "parameters": [
          {
            "name": "ms",
            "in": "query",
            "required": false,
            "description": "Milliseconds to delay",
            "schema": {
              "type": "integer",
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Slow response completed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "slept_ms": { "type": "integer" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Server busy (more than 20 concurrent slow requests)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/payload": {
      "get": {
        "summary": "Generate compressible payload",
        "description": "Returns compressible repetitive text of kb kilobytes to test CDN compression",
        "tags": ["Lab"],
        "parameters": [
          {
            "name": "kb",
            "in": "query",
            "required": false,
            "description": "Size in KB (clamped to MAX_PAYLOAD_KB)",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Compressible payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "requested_kb": { "type": "integer" },
                    "bytes": { "type": "integer" },
                    "data": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "Get hit counter statistics",
        "description": "Returns number of requests received by origin per path since startup",
        "tags": ["Lab"],
        "responses": {
          "200": {
            "description": "Map of path to hit count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/stats/reset": {
      "post": {
        "summary": "Reset hit counter statistics",
        "description": "Clears all origin hit counts. Requires X-Admin-Token header.",
        "tags": ["Lab"],
        "parameters": [
          {
            "name": "X-Admin-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stats successfully reset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized / invalid X-Admin-Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/upload": {
      "post": {
        "summary": "Upload file simulation",
        "description": "Accepts multipart file upload without saving to disk, computes SHA256 and size",
        "tags": ["Lab"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File upload processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing file or invalid form",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "File size exceeds MAX_UPLOAD_MB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "OpenAPI Specification",
        "description": "Returns OpenAPI 3.0.3 specification in JSON",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "OpenAPI specification JSON",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/robots.txt": {
      "get": {
        "summary": "Robots exclusion protocol",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Robots file",
            "content": {
              "text/plain": {}
            }
          }
        }
      }
    },
    "/sitemap.xml": {
      "get": {
        "summary": "XML Sitemap",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Sitemap XML",
            "content": {
              "application/xml": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": ["status"]
      },
      "TimeResponse": {
        "type": "object",
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": ["generated_at", "request_id"]
      },
      "CacheResponse": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_id": {
            "type": "string"
          },
          "v": {
            "type": "string"
          }
        },
        "required": ["mode", "generated_at", "request_id"]
      },
      "HeadersResponse": {
        "type": "object",
        "properties": {
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "remote_addr": {
            "type": "string"
          },
          "x_forwarded_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["headers", "remote_addr", "x_forwarded_for"]
      },
      "EchoResponse": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "method": { "type": "string" },
          "query": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "headers": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "cookies": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "form": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "body": {},
          "raw_body": { "type": "string" }
        },
        "required": ["method", "headers"]
      },
      "UploadResponse": {
        "type": "object",
        "properties": {
          "sha256": { "type": "string" },
          "size": { "type": "integer" },
          "filename": { "type": "string" },
          "content_type": { "type": "string" }
        },
        "required": ["sha256", "size", "filename", "content_type"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "request_id": { "type": "string" }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
