log_format json_combined escape=json
  '{"remote_addr":"$remote_addr",'
  '"xff":"$http_x_forwarded_for",'
  '"host":"$host",'
  '"ua":"$http_user_agent",'
  '"status":$status,'
  '"request_time":$request_time,'
  '"request_uri":"$request_uri"}';

# ==============================================================================
# HTTP Server (Port 80) - Serves traffic or proxy to Origin
# ==============================================================================
server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    client_max_body_size ${MAX_UPLOAD_MB}m;
    gzip ${ORIGIN_GZIP};
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    access_log /dev/stdout json_combined;
    error_log /dev/stderr warn;

    root /usr/share/nginx/html;

    # Vite hashed assets (immutable cache)
    location /assets/ {
        alias /usr/share/nginx/html/assets/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Lab static assets generated by cmd/genassets
    location /static/ {
        alias /srv/static/;
        etag on;
        add_header Cache-Control "public, max-age=60";
        add_header Accept-Ranges bytes;
        try_files $uri =404;
    }

    # Origin path alias for testing CDN Origin Path setting
    location /contents/ {
        alias /srv/static/;
        etag on;
        add_header Cache-Control "public, max-age=60";
        add_header Accept-Ranges bytes;
        try_files $uri =404;
    }

    # WebSocket echo endpoint
    location /ws/ {
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # API endpoints (never fall back to index.html)
    location /api/ {
        proxy_pass http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        proxy_connect_timeout 10s;
    }

    # Direct origin pass-throughs
    location = /openapi.json {
        proxy_pass http://api:8080/openapi.json;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /robots.txt {
        proxy_pass http://api:8080/robots.txt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /sitemap.xml {
        proxy_pass http://api:8080/sitemap.xml;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SPA routes fallback
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}

# ==============================================================================
# HTTPS Server (Port 443) - SSL/TLS Endpoint for WAAP / Secure Origin
# ==============================================================================
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate /etc/ssl/active/fullchain.pem;
    ssl_certificate_key /etc/ssl/active/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size ${MAX_UPLOAD_MB}m;
    gzip ${ORIGIN_GZIP};
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

