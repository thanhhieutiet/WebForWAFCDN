APP_ENV=development
HTTP_ADDR=:8080
DB_PATH=/data/labshop.db
JWT_SECRET=labshop-jwt-secret-must-be-at-least-32-chars-long-2026
ADMIN_TOKEN=labshop-admin-secret-token-key-2026
SEED=true
SEED_ADMIN_EMAIL=admin@labshop.local
SEED_ADMIN_PASSWORD=Admin@LabShop2026!
SEED_CUSTOMER_EMAIL=customer@labshop.local
SEED_CUSTOMER_PASSWORD=Customer@LabShop2026!
TUTORIAL_SHOW_DEMO_CREDS=true
MAX_UPLOAD_MB=10
MAX_SLOW_MS=60000
MAX_PAYLOAD_KB=5120
CATALOG_CACHE_SECONDS=60
ENABLE_DOCS=true
ENABLE_WS=true
CORS_ALLOWED_ORIGINS=*
SERVE_STATIC=false
STATIC_DIR=/srv/static
STORE_UPLOADS=false
APP_RATE_LIMIT_ENABLED=false
MOCK_PAYMENT_FAIL_RATE=0
ORIGIN_GZIP=off
INSTANCE_ID=labshop-origin-01
LOG_LEVEL=info

# SSL / TLS (EC2 Production with Let's Encrypt)
SSL_CERTS_DIR=/etc/letsencrypt
SSL_CERT_PATH=/etc/letsencrypt/live/thanhhieutiet.shop/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/thanhhieutiet.shop/privkey.pem
